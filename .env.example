# ==============================================================================
# EmailShield-AI - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# --- SERVER CONFIGURATION ---
HOST=0.0.0.0
PORT=8080
# Secret key used to encrypt server-side sessions in NiceGUI
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# --- GOOGLE GEMINI AI CONFIGURATION ---
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- TiDB CLOUD (MYSQL) CONFIGURATION ---
# Obtain from TiDB Cloud Console (https://tidbcloud.com) -> Connect -> Standard Connection
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_cluster_prefix.root
TIDB_PASSWORD=your_tidb_password_here
TIDB_DATABASE=emailshield
TIDB_SSL_MODE=VERIFY_IDENTITY
# Set to 'true' to allow automatic local SQLite fallback if TiDB Cloud is temporarily unreachable
USE_SQLITE_FALLBACK=true

# --- RESEND EMAIL NOTIFICATIONS CONFIGURATION ---
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Verified sender email in Resend (use onboarding@resend.dev for test accounts)
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- DATA PRIVACY & APPLICATION LIMITS ---
# Set to 'true' to store the full raw email body in the database.
# Default is 'false' to preserve user privacy (only metadata and findings are saved).
STORE_EMAIL_BODY=false
# Maximum size in bytes of emails submitted for analysis (default: 51200 = 50 KB)
MAX_EMAIL_SIZE_BYTES=51200
